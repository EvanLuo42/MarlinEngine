}

[Builtin("TextureCube")]
public struct TextureCube<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred> where T : IScalarOrVector
{
    [Intrinsic("Sample"), Stage(ShaderStage.Pixel)] public T Sample(Sampler s, float3 direction);
    [Intrinsic("SampleBias"), Stage(ShaderStage.Pixel)] public T SampleBias(Sampler s, float3 direction, float bias);
    [Intrinsic("SampleLevel")] public T SampleLevel(Sampler s, float3 direction, float lod);
    [Intrinsic("SampleGrad")] public T SampleGrad(Sampler s, float3 direction, float3 ddx, float3 ddy);
    [Intrinsic("SampleCmpLevel")]
    public float SampleCompareLevel(ComparisonSampler s, float3 direction, float reference, float lod);
    [Intrinsic("Gather")] public Vector<ScalarOf<T>, 4> Gather(Sampler s, float3 direction, int component = 0);
    [Intrinsic("TextureDimensions")] public uint2 Size { get; }
    [Intrinsic("TextureDimensions")] public uint2 GetSize(uint mip);
