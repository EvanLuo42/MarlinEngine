/// The core library of the shader dialect (MarlinLanguage.md §9.10).
namespace Marlin;

/// The stages a declaration may be used in (§9.7, §9.10).
[Flags]
public enum ShaderStage : uint
{
    Compute = 1,
    Amplification = 2,
    Mesh = 4,
    Vertex = 8,
    Pixel = 16,
    RayGeneration = 32,
    ClosestHit = 64,
    AnyHit = 128,
    Miss = 256,
    Intersection = 512,
    Callable = 1024,
    Group = Compute | Amplification | Mesh,
    RayTracing = RayGeneration | ClosestHit | AnyHit | Miss | Intersection | Callable,
}

/// Compile-time text: `nameof`, feature names and `Debug.Print` formats.
[Builtin("String")] public struct string {}

/// A device capability outside the hardware baseline (§9.7), identified by name.
[Builtin("Feature")]
public struct Feature
{
    [CompileTime("FeatureFromName")] public Feature(string name);
}

public struct Compiler
{
    /// A 16-bit ID of the struct *T* from its qualified name, never zero, the same in every compilation: what a custom
    /// BSDF's closures are tagged with (07 §4.3).
    [CompileTime("TypeId")] public static uint TypeId<T>();
    /// Requires *condition* to be true once the code is inlined and folded, for properties the code must have at
    /// compile time though they are computed, such as a Surface's shape (§9.4); reports *message* otherwise.
    [Intrinsic("Require")] public static void Require(bool condition, string message);
    /// The scalars of *value* as 32-bit words in field and component order, the rest zero; FromWords reads them back.
    /// A value with more scalars than words, or anything but scalars of 32 bits or less, is an error.
    [Intrinsic("ToWords")] public static uint[8] ToWords<T>(T value);
    [Intrinsic("FromWords")] public static T FromWords<T>(uint[8] words);
}

public struct Device
{
    /// Whether the profile being compiled has *feature*; a constant in every profile.
    [CompileTime("DeviceSupports")] public static bool Supports(Feature feature);
}

public enum MeshTopology : uint { Point, Line, Triangle }

/// The storage format of a writable texture, its third type argument (§4.4); Inferred picks it from the texel type.
public enum ImageFormat : uint
{
    Inferred = 0,
    Rgba32f = 1,
    Rgba16f,
    Rg32f,
    Rg16f,
    R11g11b10f,
    R32f,
    R16f,
    Rgba16Unorm,
    Rgb10a2Unorm,
    Rgba8Unorm,
    Rg16Unorm,
    Rg8Unorm,
    R16Unorm,
    R8Unorm,
    Rgba16Snorm,
    Rgba8Snorm,
    Rg16Snorm,
    Rg8Snorm,
    R16Snorm,
    R8Snorm,
    Rgba32i,
    Rgba16i,
    Rgba8i,
    Rg32i,
    Rg16i,
    Rg8i,
    R32i,
    R16i,
    R8i,
    R64i,
    Rgba32u,
    Rgba16u,
    Rgba8u,
    Rg32u,
    Rg16u,
    Rg8u,
    R32u,
    R16u,
    R8u,
    R64u,
}

[Builtin("Sampler")] public struct Sampler {}
[Builtin("ComparisonSampler")] public struct ComparisonSampler {}

/// Who may read and write through a texture, Ptr or Span (§4.4, §4.5).
public enum Access : uint { Read, Write, ReadWrite }

// Textures (§4.4): the shape is the type name, the access and the storage format are type arguments, so a writable
// texture is `Texture2D<float4, Access.ReadWrite, ImageFormat.Rgba16f>`. Sampling needs Access.Read; Store needs Write
// or ReadWrite. Size is mip 0; GetSize(mip) any other.

[Builtin("Texture1D")]
public struct Texture1D<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred> where T : IScalarOrVector
{
    [Intrinsic("Sample"), Stage(ShaderStage.Pixel)] public T Sample(Sampler s, float u);
    [Intrinsic("SampleLevel")] public T SampleLevel(Sampler s, float u, float lod);
    [Intrinsic("SampleGrad")] public T SampleGrad(Sampler s, float u, float ddx, float ddy);
    [Intrinsic("TextureLoad")] public T Load(int position, int mip = 0);
    [Intrinsic("TextureStore")] public void Store(int position, T value);
    [Intrinsic("TextureDimensions")] public uint Size { get; }
    [Intrinsic("TextureDimensions")] public uint GetSize(uint mip);
    [Intrinsic("TextureLevels")] public uint MipCount { get; }
}

[Builtin("Texture1DArray")]
public struct Texture1DArray<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred> where T : IScalarOrVector
{
    [Intrinsic("Sample"), Stage(ShaderStage.Pixel)] public T Sample(Sampler s, float2 uLayer);
    [Intrinsic("SampleLevel")] public T SampleLevel(Sampler s, float2 uLayer, float lod);
    [Intrinsic("TextureLoad")] public T Load(int2 positionLayer, int mip = 0);
    [Intrinsic("TextureStore")] public void Store(int2 positionLayer, T value);
    [Intrinsic("TextureDimensions")] public uint2 Size { get; }
    [Intrinsic("TextureDimensions")] public uint2 GetSize(uint mip);
    [Intrinsic("TextureLevels")] public uint MipCount { get; }
}

[Builtin("Texture2D")]
public struct Texture2D<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred> where T : IScalarOrVector
{
    [Intrinsic("Sample"), Stage(ShaderStage.Pixel)] public T Sample(Sampler s, float2 uv);
    [Intrinsic("SampleBias"), Stage(ShaderStage.Pixel)] public T SampleBias(Sampler s, float2 uv, float bias);
    [Intrinsic("SampleLevel")] public T SampleLevel(Sampler s, float2 uv, float lod);
    [Intrinsic("SampleGrad")] public T SampleGrad(Sampler s, float2 uv, float2 ddx, float2 ddy);
    [Intrinsic("SampleCmp"), Stage(ShaderStage.Pixel)]
    public float SampleCompare(ComparisonSampler s, float2 uv, float reference);
    [Intrinsic("SampleCmpLevel")] public float SampleCompareLevel(ComparisonSampler s, float2 uv, float reference, float lod);
    [Intrinsic("Gather")] public Vector<ScalarOf<T>, 4> Gather(Sampler s, float2 uv, int component = 0);
    [Intrinsic("GatherCmp")] public float4 GatherCompare(ComparisonSampler s, float2 uv, float reference);
    [Intrinsic("CalculateLod"), Stage(ShaderStage.Pixel)] public float CalculateLod(Sampler s, float2 uv);
    [Intrinsic("TextureLoad")] public T Load(int2 position, int mip = 0);
    [Intrinsic("TextureStore")] public void Store(int2 position, T value);
    [Intrinsic("TextureDimensions")] public uint2 Size { get; }
    [Intrinsic("TextureDimensions")] public uint2 GetSize(uint mip);
    [Intrinsic("TextureLevels")] public uint MipCount { get; }
}

[Builtin("Texture2DArray")]
public struct Texture2DArray<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred> where T : IScalarOrVector
{
    [Intrinsic("Sample"), Stage(ShaderStage.Pixel)] public T Sample(Sampler s, float3 uvLayer);
    [Intrinsic("SampleBias"), Stage(ShaderStage.Pixel)] public T SampleBias(Sampler s, float3 uvLayer, float bias);
    [Intrinsic("SampleLevel")] public T SampleLevel(Sampler s, float3 uvLayer, float lod);
    [Intrinsic("SampleGrad")] public T SampleGrad(Sampler s, float3 uvLayer, float2 ddx, float2 ddy);
    [Intrinsic("SampleCmp"), Stage(ShaderStage.Pixel)]
    public float SampleCompare(ComparisonSampler s, float3 uvLayer, float reference);
    [Intrinsic("SampleCmpLevel")]
    public float SampleCompareLevel(ComparisonSampler s, float3 uvLayer, float reference, float lod);
    [Intrinsic("Gather")] public Vector<ScalarOf<T>, 4> Gather(Sampler s, float3 uvLayer, int component = 0);
    [Intrinsic("TextureLoad")] public T Load(int3 positionLayer, int mip = 0);
    [Intrinsic("TextureStore")] public void Store(int3 positionLayer, T value);
    [Intrinsic("TextureDimensions")] public uint3 Size { get; }
    [Intrinsic("TextureDimensions")] public uint3 GetSize(uint mip);
    [Intrinsic("TextureLevels")] public uint MipCount { get; }
}

[Builtin("Texture2DMultisample")]
public struct Texture2DMultisample<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred>
    where T : IScalarOrVector
{
    [Intrinsic("TextureLoad")] public T Load(int2 position, int sample);
    [Intrinsic("TextureDimensions")] public uint2 Size { get; }
    [Intrinsic("TextureSamples")] public uint SampleCount { get; }
}

[Builtin("Texture3D")]
public struct Texture3D<T, Access A = Access.Read, ImageFormat F = ImageFormat.Inferred> where T : IScalarOrVector
