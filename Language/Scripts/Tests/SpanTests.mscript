/// Tests of Span and ReadOnlySpan (MarlinScript §3.5, §10.1).
namespace Marlin.Tests;

// RECOVERY-DECISION lang-files-D6: the original tests were lost; these cover every member of Span.mscript.

[Test]
void SpansViewAndWriteTheirArray()
{
    var values = new int[] { 0, 1, 2, 3, 4, 5, 6, 7 };
    Span<int> middle = values.AsSpan(2, 4);
    Assert.Equal(4, middle.Length);
    Assert.False(middle.IsEmpty);
    Assert.Equal(2, middle[0]);
    middle[1] = 30;
    Assert.Equal(30, values[3]);
    Span<int> tail = middle.Slice(2);
    Assert.Equal(2, tail.Length);
    Assert.Equal(4, tail[0]);
    Assert.True(middle.Slice(4).IsEmpty);
    int sum = 0;
    foreach (int value in middle)
    {
        sum += value;
    }
    Assert.Equal(2 + 30 + 4 + 5, sum);
}

[Test]
void SpansCopyFillAndClear()
{
    var values = new int[] { 1, 2, 3, 4, 5, 6 };
    Span<int> all = values.AsSpan();
    all.Slice(0, 4).CopyTo(all.Slice(2));
    Assert.Equal(1, values[2]);
    Assert.Equal(4, values[5]);
    all.Slice(0, 2).Fill(9);
    Assert.Equal(9, values[1]);
    all.Slice(4, 2).Clear();
    Assert.Equal(0, values[4]);
    int[] copy = all.Slice(1, 3).ToArray();
    Assert.Equal(3, copy.Length);
    Assert.Equal(9, copy[0]);
    copy[0] = 100;
    Assert.Equal(9, values[1]);
}

[Test]
void ReadOnlySpansReadAndSlice()
{
    var words = new string[] { "a", "b", "c", "d" };
    ReadOnlySpan<string> view = words.AsSpan(1, 3).AsReadOnly();
    Assert.Equal(3, view.Length);
    Assert.Equal("b", view[0]);
    Assert.Equal("d", view.Slice(1, 2)[1]);
    var target = new string[3];
    view.CopyTo(target.AsSpan());
    Assert.Equal("c", target[1]);
    string joined = "";
    foreach (string word in view)
    {
        joined = joined + word;
    }
    Assert.Equal("bcd", joined);
    Assert.Equal(3, view.ToArray().Length);
}
