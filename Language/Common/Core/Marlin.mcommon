[Intrinsic("Abs")] public T Abs<T>(T x) where T : INumeric;
[Intrinsic("Sign")] public T Sign<T>(T x) where T : INumeric;
[Intrinsic("Min")] public T Min<T>(T a, T b) where T : INumeric;
[Intrinsic("Max")] public T Max<T>(T a, T b) where T : INumeric;
[Intrinsic("Clamp")] public T Clamp<T>(T x, T low, T high) where T : INumeric;

[Intrinsic("Floor")] public T Floor<T>(T x) where T : IFloatingPoint;
[Intrinsic("Ceil")] public T Ceiling<T>(T x) where T : IFloatingPoint;
[Intrinsic("Round")] public T Round<T>(T x) where T : IFloatingPoint;
[Intrinsic("Trunc")] public T Truncate<T>(T x) where T : IFloatingPoint;
[Intrinsic("Fract")] public T Fract<T>(T x) where T : IFloatingPoint;
[Intrinsic("Sqrt")] public T Sqrt<T>(T x) where T : IFloatingPoint;
[Intrinsic("InverseSqrt")] public T InverseSqrt<T>(T x) where T : IFloatingPoint;
[Intrinsic("Exp")] public T Exp<T>(T x) where T : IFloatingPoint;
[Intrinsic("Exp2")] public T Exp2<T>(T x) where T : IFloatingPoint;
[Intrinsic("Log")] public T Log<T>(T x) where T : IFloatingPoint;
[Intrinsic("Log2")] public T Log2<T>(T x) where T : IFloatingPoint;
[Intrinsic("Pow")] public T Pow<T>(T x, T y) where T : IFloatingPoint;
[Intrinsic("Sin")] public T Sin<T>(T x) where T : IFloatingPoint;
[Intrinsic("Cos")] public T Cos<T>(T x) where T : IFloatingPoint;
[Intrinsic("Tan")] public T Tan<T>(T x) where T : IFloatingPoint;
[Intrinsic("Asin")] public T Asin<T>(T x) where T : IFloatingPoint;
[Intrinsic("Acos")] public T Acos<T>(T x) where T : IFloatingPoint;
[Intrinsic("Atan")] public T Atan<T>(T x) where T : IFloatingPoint;
[Intrinsic("Atan2")] public T Atan2<T>(T y, T x) where T : IFloatingPoint;
[Intrinsic("Sinh")] public T Sinh<T>(T x) where T : IFloatingPoint;
[Intrinsic("Cosh")] public T Cosh<T>(T x) where T : IFloatingPoint;
[Intrinsic("Tanh")] public T Tanh<T>(T x) where T : IFloatingPoint;
[Intrinsic("Saturate")] public T Saturate<T>(T x) where T : IFloatingPoint;
[Intrinsic("Lerp")] public T Lerp<T>(T a, T b, T t) where T : IFloatingPoint;
[Intrinsic("Step")] public T Step<T>(T edge, T x) where T : IFloatingPoint;
[Intrinsic("SmoothStep")] public T SmoothStep<T>(T edge0, T edge1, T x) where T : IFloatingPoint;
[Intrinsic("Fma")] public T FusedMultiplyAdd<T>(T a, T b, T c) where T : IFloatingPoint;
[Intrinsic("Ldexp")] public T Ldexp<T>(T x, T exponent) where T : IFloatingPoint;

[Intrinsic("Dot")] public T Dot<T, int N>(Vector<T, N> a, Vector<T, N> b) where T : INumeric;
[Intrinsic("Cross")] public Vector<T, 3> Cross<T>(Vector<T, 3> a, Vector<T, 3> b) where T : IFloatingPoint;
[Intrinsic("Length")] public T Length<T, int N>(Vector<T, N> v) where T : IFloatingPoint;
[Intrinsic("Distance")] public T Distance<T, int N>(Vector<T, N> a, Vector<T, N> b) where T : IFloatingPoint;
[Intrinsic("Normalize")] public Vector<T, N> Normalize<T, int N>(Vector<T, N> v) where T : IFloatingPoint;
[Intrinsic("Reflect")] public Vector<T, N> Reflect<T, int N>(Vector<T, N> i, Vector<T, N> n) where T : IFloatingPoint;
[Intrinsic("Refract")] public Vector<T, N> Refract<T, int N>(Vector<T, N> i, Vector<T, N> n, T eta) where T : IFloatingPoint;
[Intrinsic("FaceForward")] public Vector<T, N> FaceForward<T, int N>(Vector<T, N> n, Vector<T, N> i, Vector<T, N> ng) where T : IFloatingPoint;

[Intrinsic("Determinant")] public T Determinant<T, int N>(Matrix<T, N, N> m) where T : IFloatingPoint;
[Intrinsic("Inverse")] public Matrix<T, N, N> Inverse<T, int N>(Matrix<T, N, N> m) where T : IFloatingPoint;
[Intrinsic("Transpose")] public Matrix<T, C, R> Transpose<T, int R, int C>(Matrix<T, R, C> m) where T : INumeric;

[Intrinsic("IsNan")] public bool IsNaN<T>(T x) where T : IFloatingPoint, IScalar;
[Intrinsic("IsNan")] public Vector<bool, N> IsNaN<T, int N>(Vector<T, N> x) where T : IFloatingPoint;
[Intrinsic("IsInf")] public bool IsInfinity<T>(T x) where T : IFloatingPoint, IScalar;
[Intrinsic("IsInf")] public Vector<bool, N> IsInfinity<T, int N>(Vector<T, N> x) where T : IFloatingPoint;
[Intrinsic("Any")] public bool Any<int N>(Vector<bool, N> v);
[Intrinsic("All")] public bool All<int N>(Vector<bool, N> v);
public bool Any(bool v) => v;
public bool All(bool v) => v;
[Intrinsic("Select")] public T Select<T>(bool condition, T whenTrue, T whenFalse);
[Intrinsic("Select")] public Vector<T, N> Select<T, int N>(Vector<bool, N> condition, Vector<T, N> whenTrue, Vector<T, N> whenFalse);

[Intrinsic("CountBits")] public T PopCount<T>(T x) where T : IInteger;
[Intrinsic("FirstBitHigh")] public T MostSignificantBit<T>(T x) where T : IInteger;
[Intrinsic("FirstBitLow")] public T LeastSignificantBit<T>(T x) where T : IInteger;
[Intrinsic("ReverseBits")] public T ReverseBits<T>(T x) where T : IInteger;

[Intrinsic("Bitcast")] public float AsFloat(uint x);
[Intrinsic("Bitcast")] public float AsFloat(int x);
[Intrinsic("Bitcast")] public Vector<float, N> AsFloat<int N>(Vector<uint, N> x);
[Intrinsic("Bitcast")] public Vector<float, N> AsFloat<int N>(Vector<int, N> x);
[Intrinsic("Bitcast")] public uint AsUInt(float x);
[Intrinsic("Bitcast")] public uint AsUInt(int x);
[Intrinsic("Bitcast")] public Vector<uint, N> AsUInt<int N>(Vector<float, N> x);
[Intrinsic("Bitcast")] public Vector<uint, N> AsUInt<int N>(Vector<int, N> x);
[Intrinsic("Bitcast")] public int AsInt(float x);
[Intrinsic("Bitcast")] public int AsInt(uint x);
[Intrinsic("Bitcast")] public Vector<int, N> AsInt<int N>(Vector<float, N> x);
[Intrinsic("Bitcast")] public Vector<int, N> AsInt<int N>(Vector<uint, N> x);
// RECOVERY-DECISION lang-files-D2: the 64-bit bitcasts the script core library's GetHashCode(double) needs.
[Intrinsic("Bitcast")] public long AsLong(double x);
[Intrinsic("Bitcast")] public long AsLong(ulong x);
[Intrinsic("Bitcast")] public ulong AsULong(double x);
[Intrinsic("Bitcast")] public ulong AsULong(long x);
[Intrinsic("Bitcast")] public double AsDouble(long x);
[Intrinsic("Bitcast")] public double AsDouble(ulong x);

[Intrinsic("PackHalf2x16")] public uint PackHalf2x16(float2 v);
[Intrinsic("UnpackHalf2x16")] public float2 UnpackHalf2x16(uint packed);
