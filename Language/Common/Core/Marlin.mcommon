/// The core library every dialect sees (MarlinLanguage.md §9.10, MarlinScript §1.3).
namespace Marlin;

/// Satisfied by bool, the integers and the floating-point types.
[Builtin("IScalar")] public interface IScalar {}
/// Satisfied by scalars and vectors.
[Builtin("IScalarOrVector")] public interface IScalarOrVector {}
/// Satisfied by integer and floating-point scalars and vectors.
[Builtin("INumeric")] public interface INumeric {}
/// Satisfied by integer scalars and vectors.
[Builtin("IInteger")] public interface IInteger {}
/// Satisfied by half, float and double scalars and vectors.
[Builtin("IFloatingPoint")] public interface IFloatingPoint {}
/// Satisfied by bool scalars and vectors.
[Builtin("ILogical")] public interface ILogical {}

/// `T.Zero` and `T.One` of the numeric scalars and vectors, for generic code over INumeric (§3.5).
public extension<T> T where T : INumeric
{
    public static T Zero => (T)0;
    public static T One => (T)1;
}

/// The declarations an attribute struct may be put on, as in `[Attribute(AttributeTargets.Field)]` (§3.7).
[Flags]
public enum AttributeTargets : uint
{
    Struct = 1,
    Field = 2,
    Function = 4,
    Parameter = 8,
    GenericParameter = 16,
    Enum = 32,
    Interface = 64,
    All = Struct | Field | Function | Parameter | GenericParameter | Enum | Interface,
}

/// Satisfied by numeric scalars, and by the structs that declare it.
[Builtin("IComparable")]
public interface IComparable<T>
{
    /// Negative, zero or positive as this is less than, equal to or greater than *other*.
    int CompareTo(T other);
}

/// The scalar of a scalar or vector type: `ScalarOf<half3>` is `half`.
[Builtin("ScalarOf")] public struct ScalarOf<T> {}

/// Orders two numeric scalars, so they satisfy IComparable.
public int CompareTo<T>(this T a, T b) where T : INumeric, IScalar => a < b ? -1 : (a > b ? 1 : 0);

/// Two to four components of a scalar type.
[Builtin("Vector")] public struct Vector<T, int N> where T : IScalar {}
/// R rows of C components of a numeric type.
[Builtin("Matrix")] public struct Matrix<T, int R, int C> where T : INumeric {}

/// The integers from Start up to but excluding End, for `foreach`.
[Builtin("Range")]
public struct Range
{
    public int Start;
    public int End;
    public Range(int start, int end) { Start = start; End = end; }
}

