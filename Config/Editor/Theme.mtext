    AudioWaveform = <audio-waveform#5965396e-4368-5b89-adb7-dbe91d50d627>
    Box = <box#7155a049-ff2d-5fa0-b847-97c8d3745d91>
    Bug = <bug#827b609e-435a-5ad6-83bd-62b8fa3dbdd0>
    ChevronDown = <chevron-down#5cae98fc-e70f-5aeb-ac7f-cf069522ee4d>
    ChevronLeft = <chevron-left#b7dfacb0-b1f1-5c4c-a719-8f9fd7462b65>
    ChevronRight = <chevron-right#0e4f7389-a370-54e8-bce3-0594915ac92d>
    CircleDot = <circle-dot#595af866-ef46-5c0b-a898-bbc29567edaa>
    Copy = <copy#5c6d7df1-9c47-53c9-912a-31f1e175daaf>
    Download = <download#7d240b79-2e6a-55b0-ae9a-375c31ce215e>
    ExternalLink = <external-link#c84aee84-a97e-5f75-b7ca-9953b0723069>
    File = <file#b4534f6e-26d0-5cad-961b-d9da1a29c8f4>
    Folder = <folder#6f6887e1-7a2c-5555-b760-2657cac9aa06>
    FolderOpen = <folder-open#7cb5a82c-bb01-530f-8bbc-2f6ebaedb958>
    FolderPlus = <folder-plus#c5ed0f9e-d753-5d8f-a4a2-81c960d7778a>
