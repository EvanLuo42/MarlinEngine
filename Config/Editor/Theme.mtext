!Version "1.0"

// The editor theme (Documentation/Architecture/09 §4.5): a dense dark tool UI, 11–12 px text, accent #F0A531. Plugins,
// the project and the user override single tokens in their own Config/Editor/Theme.mtext; `Editor.ReloadTheme` reads
// it again. UI code reads tokens by name with ThemeColor("Panel.Background"), ThemeMetric("Spacing.Medium") and
// IconView("FolderOpen", …); a nested block names its tokens with dots.

// Colors are "#RRGGBB" or "#RRGGBBAA" in sRGB, or the name of another color token (in quotes when it has dots).
Colors
{
    // The palette: grays from darkest to lightest, and the hues. The roles below name these.
    Gray0 = "#0C0C0C"
    Gray1 = "#0F0F0F"
    Gray2 = "#111111"
    Gray3 = "#151515"
    Gray4 = "#1A1A1A"
    Gray5 = "#1B1B1B"
    Gray6 = "#202020"
    Gray7 = "#232323"
    Gray8 = "#252525"
    Gray9 = "#2B2B2B"
    Gray10 = "#2E2E2E"
    Gray11 = "#3A3A3A"
    Gray12 = "#555555"
    Gray13 = "#777777"
    Gray14 = "#999999"
    Gray15 = "#9A9A9A"
    Gray16 = "#C4C4C4"
    Gray17 = "#C9C9C9"
    Gray18 = "#E8E8E8"
    White = "#FFFFFF"
    Orange = "#F0A531"
    OrangeLight = "#FFC266"
    OrangeDark = "#C8861F"
    Gold = "#E8B54A"
    Mint = "#4FC3A1"
    Periwinkle = "#8A9CF0"
    Green = "#3FCE52"
    Yellow = "#E3D36A"
    Red = "#E0584A"
    AxisX = "#D9453A"
    AxisY = "#4AA83C"
    AxisZ = "#3B6FD6"

    // Roles.
    // The bottom layer of every editor window: the docks' color, so docks stand apart by their shadows alone.
    Window =
    {
        Background = "Dock.Background"
        Border = Gray0
    }
    Content = { Background = "Dock.Background" }
    Text =
    {
        Primary = Gray17
        Strong = Gray18
        Secondary = Gray15
        Disabled = Gray13
        OnAccent = White
        Link = Orange
        LinkHovered = OrangeLight
    }
    Accent =
    {
        Normal = Orange
        Hovered = OrangeLight
        Pressed = OrangeDark
    }
    Separator = Gray2

    // The main window's own title bar: a tab per editing context, and the window buttons.
    TitleBar = { Background = Gray1 }
    Tab =
    {
        Background = Gray4
        Hovered = "#212121"
        Active = Gray9
        Text = Gray15
        ActiveText = Gray18
        // The line over the active tab.
        Indicator = Orange
        Close = Gray13
        CloseHovered = Gray18
        Icon =
        {
            AssetManager = Gold
            Tool = Mint
            Asset = Periwinkle
        }
    }
    // Minimize, maximize and close: a box that fills on hover, like the menu bar's labels; close turns red.
    WindowButton =
    {
        Glyph = Gray14
        Hovered = Gray11
        HoveredGlyph = White
        Close =
        {
            Hovered = "#C42B1C"
            HoveredGlyph = White
        }
    }
    MenuBar =
    {
        Background = Gray7
        Border = Gray2
        Text = Gray16
        Hovered = Gray11
        HoveredText = White
    }
    // Dropdown menus of the menu bar.
    Menu =
    {
        Background = Gray8
        Border = Gray11
        Text = Gray16
        Shortcut = Gray15
        ItemHovered = Gray11
        ItemHoveredText = White
        Separator = Gray11
    }
    StatusBar =
    {
        Background = Gray6
        Border = Gray2
        Text = Gray15
    }

    Panel =
    {
        Background = Gray8
        Header = Gray10
        Border = Gray0
    }
    // Docks of an editing context: a header with the title, or a tab per stacked dock, and ⧉ / ✕.
    Dock =
    {
        Background = Gray10
        // Behind and between the docks: the docks' own color, with their shadows setting them apart.
        AreaBackground = "Dock.Background"
        Shadow = "#00000099"
        // The title bar with ⧉ and ✕, darker than the dock.
        Header = Gray8
        TitleText = Gray16
        TabText = Gray15
        TabActive = "Dock.Background"
        TabHovered = "#353535"
        Button = Gray15
        ButtonHovered = Gray18
        // The gaps between docks, which drag to resize them.
        SplitterHovered = "#F0A53166"
        // Where a dragged dock would go.
        DropPreview = "#F0A5312E"
        DropPreviewBorder = Orange
        // Where a dragged dock would float, when it is over no guide.
        FloatPreview = "#FFFFFF14"
        FloatPreviewBorder = "#FFFFFF59"
        // The drop guides shown while a dock is dragged.
        GuideBackground = "#1E1E1EEE"
        GuideBorder = Gray11
        GuideHoveredBorder = Orange
        GuideGlyph = Gray16
        GuideFill = "#F0A53199"
        GuideHoveredFill = Orange
    }
    // The dock on top of an editing context.
    Toolbar =
    {
        // Like the other docks: a darker header over the dock's color.
        Background = "Dock.Background"
        Header = "Dock.Header"
        HeaderText = Gray15
        ButtonHovered = "#3A3A3A"
        Label = Gray16
        Icon = "#D4D4D4"
        ValidateIcon = "#4FC35A"
        SourceControlIcon = Orange
        Separator = Gray11
    }
    Input =
    {
        Background = Gray3
        Border = Gray11
        FocusedBorder = "Accent.Normal"
        Text = "#E6E6E6"
        Placeholder = "#666666"
        Icon = Gray14
        Caret = Orange
    }

    // Controls (EditorUI/UIControls.h).
    Button =
    {
        Background = "#333333"
        Border = "#474747"
        Text = "#DDDDDD"
        HoveredBackground = "#3D3D3D"
        HoveredBorder = "#474747"
        HoveredText = "#DDDDDD"
        DisabledBackground = "#2A2A2A"
        DisabledBorder = "#383838"
        DisabledText = "#666666"
        Primary =
        {
            Background = Orange
            Border = Orange
            Text = "#1A1208"
            HoveredBackground = "#FFB44A"
            HoveredBorder = "#FFB44A"
            HoveredText = "#1A1208"
            DisabledBackground = OrangeDark
            DisabledBorder = OrangeDark
            DisabledText = "#4A3A1A"
        }
    }
    Chip =
    {
        Background = "#00000000"
        HoveredBackground = "#363636"
        Border = Gray11
        Text = Gray16
        ActiveBackground = "#3A3226"
        ActiveBorder = Orange
        ActiveText = White
    }
    Slider =
    {
        Track = "#3C3C3C"
        Fill = Orange
        Knob = Gray18
        KnobBorder = Orange
    }
    Segmented =
    {
        Background = "#00000000"
        Hovered = "#363636"
        Active = "#3A3226"
        Border = Gray11
        Text = Gray15
        ActiveText = Orange
    }
    Scrollbar = { Thumb = "#FFFFFF26" }
    Section =
    {
        Header = "#353535"
        Border = Gray4
        Text = "#DDDDDD"
        Caret = "#AAAAAA"
    }
    Tree =
    {
        Background = "#00000000"
        Hovered = "#353535"
        Selected = "Selection.Background"
        Text = Gray16
        SelectedText = White
        Count = Gray13
        Group = "#8A8A8A"
        Caret = "#AAAAAA"
        Icon = Gray15
        Divider = Gray4
    }
    Tag =
    {
        Background = Gray4
        Border = Gray11
        HoveredBorder = Orange
        Text = "#CFCFCF"
    }

    // The Asset Manager.
    AssetManager =
    {
        Folder = "#C9A14A"
        Star = Orange
    }
    AssetType =
    {
        Texture = "#D9665A"
        Mesh = "#4AA3DF"
        Material = "#4FC35A"
        Audio = "#E8B54A"
        Animation = "#8A9CF0"
        Prefab = "#4FC3A1"
        Vfx = "#D98AE0"
        Level = "#7FB0E6"
        Font = "#C9A14A"
        Icon = "#B8B8B8"
        Other = Gray14
    }
    Browser =
    {
        Background = "Dock.Background"
        Bar = "Dock.Header"
        Divider = Gray4
    }
    Breadcrumb =
    {
        Text = Gray15
        Current = Gray18
        Hovered = "#3A3A3A"
        Separator = Gray13
    }
    // Lighter than the dock they sit on, with a darker thumbnail.
    Tile =
    {
        Background = "#363636"
        Hovered = "#3D3D3D"
        Border = "#3E3E3E"
        Thumbnail = "#292929"
        Text = "#D4D4D4"
        Type = "#808080"
        SelectedBackground = "#3A3226"
        SelectedBorder = Orange
        SelectedText = White
    }
    List =
    {
        Background = "#00000000"
        Alternate = "#2A2A2A"
        Hovered = "#363636"
        Selected = "Selection.Background"
        Header = "#2E2E2E"
        HeaderText = Gray16
        Secondary = "#A8A8A8"
        Path = "#8A8A8A"
    }
    Details =
    {
        Preview = "#232323"
        PreviewBorder = "#3A3A3A"
        Key = "#A8A8A8"
        Value = "#DDDDDD"
        Empty = "#7A7A7A"
    }
    Selection = { Background = "#5A4A2C" }
    FocusRing = "Accent.Normal"
    Status =
    {
        Success = Green
        Warning = Yellow
        Error = Red
    }
    Axis =
    {
        X = AxisX
        Y = AxisY
        Z = AxisZ
    }
}

// Painter units.
Metrics
{
    Spacing =
    {
        XSmall = 2
        Small = 4
        Medium = 6
        Large = 12
        XLarge = 16
    }
    Radius =
    {
        Small = 2
        Medium = 3
        Large = 4
    }
    FontSize =
    {
        Small = 10.5
        Normal = 11
        Medium = 12
        Large = 15
        Title = 20
    }
    TitleBar =
    {
        Height = 28
        PaddingLeft = 6
        Gap = 4
    }
    Tab =
    {
        Height = 26
        MinWidth = 150
        PaddingX = 12
        Gap = 7
        // The top corners only.
        Radius = 6
        IndicatorHeight = 2
        IconSize = 14
        CloseSize = 10
    }
    WindowButton =
    {
        // TitleBar.Height, so the buttons are square.
        Width = 28
        IconSize = 14
    }
    MenuBar =
    {
        Height = 20
        PaddingX = 6
        Gap = 2
        ItemHeight = 18
        ItemPaddingX = 6
    }
    Menu =
    {
        ItemHeight = 20
        MinWidth = 200
    }
    StatusBar =
    {
        Height = 18
        PaddingX = 8
        Gap = 16
    }
    Dock =
    {
        HeaderHeight = 20
        TabPaddingX = 8
        // The top corners of stacked docks' tabs.
        TabRadius = 4
        ButtonSize = 10
        // Between docks and around them.
        Gap = 2
        // The docks' shadows: blur (standard deviation) and how far they grow past the dock.
        ShadowBlur = 3
        ShadowSpread = 0
        // The drop guides: their size, and the space between those of the compass and from the edges.
        GuideSize = 30
        GuideGap = 4
    }
    Toolbar =
    {
        HeaderHeight = 18
        // Below the header.
        Height = 52
        PaddingX = 6
        IconSize = 18
        ButtonMinWidth = 52
    }
    // A dock dragged out of the main window.
    FloatingWindow =
    {
        TitleHeight = 24
        ButtonWidth = 36
        IconSize = 12
    }
    ControlHeight = 24
    RowHeight = 19
    Button = { PaddingX = 12 }
    Input = { IconSize = 13 }
    Chip =
    {
        Height = 22
        IconSize = 12
    }
    Slider = { KnobSize = 12 }
    Segmented =
    {
        Height = 20
        IconSize = 13
    }
    Scrollbar = { Width = 4 }
    Section = { HeaderHeight = 20 }
    Tree =
    {
        RowHeight = 20
        Indent = 14
    }
    Tile = { Gap = 10 }
    List = { RowHeight = 22 }
}

// Icon assets by token (IconView, EditorTheme::GetIcon); Lucide (Content/Icons/Lucide).
Icons
